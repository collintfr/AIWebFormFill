{
  "manifest_version": 3,
  "name": "AI Form Fill Helper",
  "version": "2.0.0",
  "permissions": ["activeTab", "contextMenus", "storage", "scripting", "clipboardWrite"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Open encrypted vault options" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; connect-src 'self' https://huggingface.co https://cas-bridge.xethub.hf.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.hf.co https://us.aws.cdn.hf.co"
  },
  "icons": { "16": "img/icon16.png", "48": "img/icon48.png", "128": "img/icon128.png" },
  "browser_specific_settings": {
    "gecko": { "id": "ask.ivo@gmail.com", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
